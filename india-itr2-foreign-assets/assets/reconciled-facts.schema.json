{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITR reconciled facts",
  "type": "object",
  "required": ["schema_version", "facts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "kind",
          "values",
          "depends_on",
          "derivation",
          "status"
        ],
        "properties": {
          "fact_id": {"type": "string"},
          "kind": {"type": "string"},
          "values": {"type": "object"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "derivation": {"type": "string"},
          "status": {
            "enum": [
              "RECONCILED",
              "PROVISIONAL",
              "ASSUMPTION",
              "UNRESOLVED",
              "STALE"
            ]
          },
          "notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
